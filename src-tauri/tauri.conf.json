{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "RailGraph",
  "version": "2.0.0",
  "identifier": "com.railgraph.app",
  "build": {
    "beforeDevCommand": { "script": "trunk serve --port 1420", "cwd": ".." },
    "beforeBuildCommand": { "script": "trunk build --release && node scripts/inject-wasm-build-id.mjs dist", "cwd": ".." },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RailGraph",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/SuperManifolds/rail_graph/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFN0Q2MjI2RDBGNjgwOApSV1FJYUE5dEl0Ym5DVWQ5S3UzN1JYVTczSXlsTlVEKzFUaElVemJpODh1S1B3VEN5bjV3ZC96ZAo="
    }
  }
}
